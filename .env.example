# ---- Runtime environment ----
# Path to the SQLite DB (source of truth). Defaults to ./data/app.db
DB_PATH=./data/app.db

# Directory where Plan screenshots / artifacts are written. Defaults to ./artifacts
ARTIFACTS_DIR=./artifacts

# ---- Sender identity (L3 templates / compliance §9) ----
# These are injected into the outbound message AND typed into the form.
# Everything here must be truthful — it is what the recipient replies to.
SENDER_COMPANY=株式会社ネオキャリア
SENDER_PRODUCT=MOCHICA
SENDER_PERSON=福井 聖
# Romaji reading shown in the signature block (e.g. "Sho Fukui"). Optional.
SENDER_PERSON_ROMAJI=
SENDER_EMAIL=
# 会社代表番号。フォームの「電話番号」欄に入る既定値。空だと電話欄を埋めない。
SENDER_PHONE=
# 携帯。署名に記載し、フォームに「携帯電話」欄がある場合はそちらへ入力する。
SENDER_MOBILE=
SENDER_FAX=
SENDER_URL=
# Katakana reading of 姓/名 — fills split フリガナ (セイ/メイ) fields (課題B).
SENDER_KANA_SEI=
SENDER_KANA_MEI=
# Sender company postal (e.g. 160-0023) — fills split 郵便番号 (上3桁/下4桁) (課題A).
SENDER_POSTAL=
# 本社所在地。都道府県／市区町村／番地・建物名に自動分割して入力する。
SENDER_ADDRESS=
SENDER_OFFICE=
# Department to fill when a 部署 field is present.
SENDER_DEPARTMENT=

# ---- L2 LLM fallback (optional). If absent, L2 falls back to rules only. ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# ---- Pacing / safety (L4) ----
# Max final submissions per day (Execute phase). Plan/dry-run is unlimited.
DAILY_SEND_LIMIT=200
# Allowed sending window (24h local time). Outside this window Execute is blocked.
SEND_WINDOW_START=9
SEND_WINDOW_END=19
# Min / max random delay (ms) between final submissions.
SEND_MIN_INTERVAL_MS=45000
SEND_MAX_INTERVAL_MS=120000

# ---- Browser ----
# Set to "false" to watch the browser during debugging.
HEADLESS=true

# ---- L6 Google Sheets report sync (optional; §13-4) ----
# Create a spreadsheet, share it (Editor) with the service account's email,
# then set the id + the path to the service-account JSON key. Unset => CSV only.
SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=./secrets/service-account.json
SHEETS_REPORT_TAB=report
SHEETS_SUPPRESSION_TAB=suppression

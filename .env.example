# ---- Runtime environment ----
# Path to the SQLite DB (source of truth). Defaults to ./data/app.db
DB_PATH=./data/app.db

# Directory where Plan screenshots / artifacts are written. Defaults to ./artifacts
ARTIFACTS_DIR=./artifacts

# ---- Sender identity (L3 templates / compliance §9) ----
# These are injected into the outbound message AND typed into the form.
# Everything here must be truthful — it is what the recipient replies to.
SENDER_COMPANY=株式会社ネオキャリア
SENDER_PRODUCT=MOCHICA
SENDER_PERSON=福井 聖
# Romaji reading shown in the signature block (e.g. "Sho Fukui"). Optional.
SENDER_PERSON_ROMAJI=
SENDER_EMAIL=
# フォームの「電話番号」欄に入力する連絡先番号。署名の連絡先行にも載る。
# 空だと電話欄を埋めない（架空の番号は入れない）。
SENDER_PHONE=
# 本社代表番号。署名の◆本社ブロックにのみ載せる（フォームには入力しない）。
SENDER_OFFICE_PHONE=
SENDER_FAX=
SENDER_URL=
# 日程調整（オンライン商談予約）URL。設定すると本文の日程調整案内が出る。
# 空にすると案内文ごと消える（リンクの無い「下記より」だけが残らない）。
SENDER_BOOKING_URL=https://booking.receptionist.jp/mochicasales2025/30min
# Katakana reading of 姓/名 — fills split フリガナ (セイ/メイ) fields (課題B).
SENDER_KANA_SEI=
SENDER_KANA_MEI=
# Sender company postal (e.g. 160-0023) — fills split 郵便番号 (上3桁/下4桁) (課題A).
SENDER_POSTAL=
# 本社所在地。都道府県／市区町村／番地・建物名に自動分割して入力する。
SENDER_ADDRESS=
SENDER_OFFICE=
# Department to fill when a 部署 field is present.
SENDER_DEPARTMENT=

# ---- L2 LLM fallback (optional). If absent, L2 falls back to rules only. ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# ---- Pacing / safety (L4) ----
# Max final submissions per day (Execute phase). Plan/dry-run is unlimited.
DAILY_SEND_LIMIT=200
# 送信可能時間帯（24時間制・ローカル時刻）。既定 7-23 = 深夜（23時〜翌 7 時）は送信しない。
# 時間外に入っても一斉送信は終了せず待機し、窓が開いたら自動で再開する。
# 止まるのは本送信 (L4 Execute) だけ。取り込み・発見・プラン作成は深夜も走る。
# 0-24（または start === end）にすると 24 時間送信。
# start > end（例: 20-6）は日をまたぐ夜間帯として扱う。
SEND_WINDOW_START=7
SEND_WINDOW_END=23
# Min / max random delay (ms) between final submissions.
# 送信間隔はワーカーごとに独立して効くので、実効レートは SEND_CONCURRENCY 倍。
SEND_MIN_INTERVAL_MS=45000
SEND_MAX_INTERVAL_MS=120000
# 一斉送信を何社同時に走らせるか（マルチスレッド送信）。
# 1社の送信は 30-90 秒（大半がネットワーク待ち）なので、上げるほど素直に速くなる。
# ただし 1社 = Chromium 1プロセス（200-400MB）。メモリと相談して決めること。
SEND_CONCURRENCY=3

# ---- Browser ----
# Set to "false" to watch the browser during debugging.
HEADLESS=true
# 同時に起動してよい Chromium プロセスの上限（全レイヤ横断）。
# 取り込み（L1発見/L2解析）と一斉送信（L4）は**並走**するので、
# レイヤごとの並列数を足した値が実際の同時起動数になる。
# 1プロセス 200-400MB 使うため、ここで頭を押さえないと 3万件の後半でメモリを踏み抜く。
# 既定 = INTAKE_CONCURRENCY(3) + SEND_CONCURRENCY(3)。送信は待ち行列の先頭に入る（優先枠）。
BROWSER_MAX_CONCURRENCY=6

# ---- リスト取り込み (L0) の処理量チューニング ----
# 取り込みは「保存 → チャンクごとに処理 → チェックポイント」で進むため、
# 3万件のリストでも中断・再開できる（進捗は import_jobs / import_rows に保存）。
# 1トランザクション（=1チェックポイント）あたりの行数。大きいほど速く、
# 中断時に巻き戻る量が増える。
INTAKE_CHUNK_SIZE=500
# フォーム発見(L1)+解析(L2)+プラン(L4)を何社同時に処理するか。
# 1社ごとに Chromium を起動するので、マシンのメモリと相談して上げること。
INTAKE_CONCURRENCY=3
# HP自動探索（Web検索）の同時実行数。検索側のレート制限があるため控えめに。
# HTTP のみ（Chromium を使わない）なので BROWSER_MAX_CONCURRENCY とは競合しない。
INTAKE_RESOLVE_CONCURRENCY=2

# ---- L6 Google Sheets report sync (optional; §13-4) ----
# Create a spreadsheet, share it (Editor) with the service account's email,
# then set the id + the path to the service-account JSON key. Unset => CSV only.
SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=./secrets/service-account.json
SHEETS_REPORT_TAB=report
SHEETS_SUPPRESSION_TAB=suppression

# ---- 一斉メール送信 (M) ----
# フォーム送信とは独立した第2チャネル。企業サイトに掲載されているアドレスを
# 自動で探し、そこへ送る。抑制リスト（配信停止・送信済み）はフォーム側と共有する。
#
# SMTP。ここが空だとメール機能は起動しない（フォーム送信には影響しない）。
#   Google Workspace : smtp.gmail.com / 587 / ユーザー = 送信元アドレス
#                      パスワードは「アプリ パスワード」（通常のログインPWは不可）
#   SendGrid         : smtp.sendgrid.net / 587 / ユーザー = "apikey"
#   Amazon SES       : email-smtp.<region>.amazonaws.com / 587 / SMTP認証情報
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 差出人。未設定なら SENDER_EMAIL を使う。実在し、返信を受け取れるアドレスにすること。
SMTP_FROM=
SMTP_REPLY_TO=
# 465 を使うときだけ true（587 は STARTTLS）。通常はポートから自動判定される。
# SMTP_SECURE=false

# 1日の送信上限。SMTP 提供元の上限に合わせる（Google Workspace は 2,000通/日）。
# 上限に達すると送信は止まり、日付が変わると自動で再開する。
EMAIL_DAILY_LIMIT=300
# 同時送信数と送信間隔 (ms)。連続送信は迷惑メール判定を招くので必ず空ける。
EMAIL_CONCURRENCY=2
EMAIL_MIN_INTERVAL_MS=8000
EMAIL_MAX_INTERVAL_MS=20000

# 掲載が確認できないアドレス（info@ドメイン 等の推測）にも送るか。
# 既定 false。特定電子メール法のオプトイン例外は「自己のメールアドレスを
# 公開している団体・営業を営む個人」への送信を根拠にするため、掲載を確認
# できていないアドレスへ送るとその根拠を失う。バウンス率も上がる。
EMAIL_ALLOW_GUESSED=false

# ---- クリック検知 / 配信停止 ----
# メール本文のリンクを計測 URL に差し替え、クリックを記録する。
# **受信者のブラウザから到達できる URL** が必要（localhost では機能しない）。
#   例: https://track.example.co.jp        （リバースプロキシ経由）
#       https://xxxx.trycloudflare.com     （Cloudflare Tunnel などで一時的に公開）
# 未設定の場合はクリック計測を行わず、本文には実 URL をそのまま載せる
# （届かないリンクを送るより、計測を諦める方が安全）。配信停止も本文リンクではなく
# 「返信でお知らせください」の案内に切り替わる。
PUBLIC_BASE_URL=
EMAIL_TRACK_CLICKS=true
